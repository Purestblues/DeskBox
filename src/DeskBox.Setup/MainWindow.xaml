<Window x:Class="DeskBox.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBox 安装向导"
        Width="560"
        Height="415"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#1C1E24"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE2EC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="17" Height="17"
                                    CornerRadius="3"
                                    Background="#2B2F39"
                                    BorderBrush="#484F5E"
                                    BorderThickness="1"
                                    Margin="0,0,10,0">
                                <TextBlock x:Name="Check"
                                           Text="✓"
                                           Foreground="#3B82F6"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#363B48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D313B"/>
            <Setter Property="Foreground" Value="#E6ECF5"/>
            <Setter Property="BorderBrush" Value="#434A58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3F4C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4E91FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#2E4266"/>
                                <Setter Property="Foreground" Value="#8EA6CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#323743" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="#17191E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Border Width="16" Height="16" CornerRadius="4" Background="#3B82F6" Margin="0,0,10,0">
                        <Grid Margin="3">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="White" Margin="0.8" CornerRadius="0.8"/>
                            <Border Grid.Row="0" Grid.Column="1" Background="White" Margin="0.8" CornerRadius="0.8"/>
                            <Border Grid.Row="1" Grid.Column="0" Background="White" Margin="0.8" CornerRadius="0.8"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="White" Margin="0.8" CornerRadius="0.8"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="WindowHeaderTitle" Text="DeskBox 安装向导" Foreground="#ECEFF4" FontSize="13.5" FontWeight="Medium"/>
                </StackPanel>
                <Button x:Name="CloseButton"
                        AutomationProperties.Name="关闭"
                        HorizontalAlignment="Right"
                        Width="44" Height="44"
                        Background="Transparent"
                        Foreground="#9AA3B2"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        Content="✕"/>
            </Grid>

            <!-- 主内容区 -->
            <Grid Grid.Row="1" Margin="28,20,28,10">
                <!-- 安装界面 -->
                <StackPanel x:Name="InstallPanel" Visibility="Visible">
                    <TextBlock Text="DeskBox 轻量桌面格子 v1.1.0" Foreground="#FFFFFF" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="单进程极致低占用 · 无云搜索无推销 · 多显示器拓扑防错乱" Foreground="#97A1B0" FontSize="12.5" Margin="0,6,0,18"/>

                    <TextBlock Text="安装目录（免管理员权限，支持覆盖升级）" Foreground="#B8C0CE" FontSize="12.5" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallDir"
                                 AutomationProperties.Name="安装路径"
                                 Grid.Column="0"
                                 Height="34"
                                 Background="#252831"
                                 Foreground="#F0F4FA"
                                 BorderBrush="#3D4352"
                                 BorderThickness="1"
                                 Padding="10,7"
                                 FontSize="12.5"
                                 VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnBrowse"
                                AutomationProperties.Name="浏览安装目录"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="浏览..."
                                Margin="10,0,0,0"
                                Click="BtnBrowse_Click"/>
                    </Grid>

                    <CheckBox x:Name="ChkDesktopShortcut"
                              AutomationProperties.Name="创建桌面快捷方式"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Content="创建桌面快捷方式"
                              IsChecked="True"/>
                    <CheckBox x:Name="ChkStartMenuShortcut"
                              AutomationProperties.Name="创建开始菜单快捷方式"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Content="创建开始菜单快捷方式"
                              IsChecked="True"/>
                    <CheckBox x:Name="ChkAutoStart"
                              AutomationProperties.Name="开机自动启动 DeskBox"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Content="开机自动启动 DeskBox"
                              IsChecked="True"/>
                    <CheckBox x:Name="ChkLaunchAfter"
                              AutomationProperties.Name="安装完成后立即启动"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Content="安装完成后立即启动"
                              IsChecked="True"/>
                </StackPanel>

                <!-- 卸载界面 -->
                <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                    <TextBlock Text="卸载 DeskBox 桌面格子" Foreground="#FFFFFF" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="将从以下位置移除程序文件、快捷方式及系统卸载条目：" Foreground="#97A1B0" FontSize="12.5" Margin="0,8,0,12"/>

                    <Border Background="#252831" BorderBrush="#383E4C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,18">
                        <TextBlock x:Name="TxtUninstallDir" Foreground="#E6ECF5" FontSize="12.5" TextWrapping="Wrap"/>
                    </Border>

                    <CheckBox x:Name="ChkRemoveConfig"
                              AutomationProperties.Name="同时清理本地配置与布局快照"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Content="同时删除个人格子配置与多屏布局快照（默认保留，不勾选则安全保留）"
                              IsChecked="False"/>
                </StackPanel>
            </Grid>

            <!-- 底部状态与主操作栏 -->
            <Border Grid.Row="2" Background="#191B20" BorderBrush="#2B2F3A" BorderThickness="0,1,0,0" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="TxtStatus" Text="准备就绪" Foreground="#A5AEBD" FontSize="12" Margin="0,0,0,6"/>
                        <ProgressBar x:Name="Progress"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Background="#2A2E38"
                                     Foreground="#3B82F6"
                                     BorderThickness="0"/>
                    </StackPanel>

                    <Button x:Name="BtnPrimary"
                            AutomationProperties.AutomationId="PrimaryActionButton"
                            AutomationProperties.Name="立即安装"
                            Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="立即安装"
                            Click="BtnPrimary_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
