<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\DeskBox\Assets\deskbox.ico</ApplicationIcon>
    <AssemblyName>DeskBox.Setup</AssemblyName>
    <RootNamespace>DeskBox.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <Product>DeskBox 安装向导</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\payload.zip" Condition="Exists('Resources\payload.zip')" />
  </ItemGroup>

</Project>
