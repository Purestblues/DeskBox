<Window x:Class="DeskBox.Views.DragPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Border Background="#DC23262E"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8,5"
            MaxWidth="220">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="PreviewIcon" Width="24" Height="24" Margin="0,0,7,0"/>
            <TextBlock x:Name="PreviewTitle"
                       Foreground="#F5FFFFFF"
                       FontSize="12"
                       VerticalAlignment="Center"
                       MaxWidth="150"
                       TextTrimming="CharacterEllipsis"/>
            <Border x:Name="CountBadge"
                    Background="#3B82F6"
                    CornerRadius="8"
                    Padding="5,1"
                    Margin="6,0,0,0"
                    Visibility="Collapsed"
                    VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
