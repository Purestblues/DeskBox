<Window x:Class="DeskBox.Views.NordConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBox 确认"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Border Margin="10"
            Background="{DynamicResource NordSurface4Brush}"
            BorderBrush="{DynamicResource NordBorderPopupBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.24" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="20,18,20,18">
            <Grid Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="28" Height="28"
                        CornerRadius="6"
                        Background="{DynamicResource NordWarningTintBrush}"
                        Margin="0,0,10,0">
                    <Path x:Name="IconPath"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 7,1 L 13,12 L 1,12 Z M 7,5 V 8 M 7,10 V 10.2"
                          Stroke="{DynamicResource NordWarningBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Border>
                <TextBlock x:Name="TxtTitle"
                           Grid.Column="1"
                           Text="确认操作"
                           Style="{StaticResource NordSectionHeaderStyle}"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnClose"
                        Grid.Column="2"
                        AutomationProperties.Name="关闭"
                        Style="{StaticResource NordWindowCloseButtonStyle}"
                        Click="BtnCancel_Click"/>
            </Grid>

            <TextBlock x:Name="TxtMessage"
                       Style="{StaticResource NordSettingCaptionStyle}"
                       FontSize="13"
                       LineHeight="20"
                       Foreground="{DynamicResource NordTextSecondaryBrush}"
                       Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        AutomationProperties.Name="取消"
                        Style="{StaticResource NordSecondaryButtonStyle}"
                        Content="取消"
                        MinWidth="78"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnConfirm"
                        AutomationProperties.Name="确定"
                        Style="{StaticResource NordPrimaryButtonStyle}"
                        Content="确定"
                        MinWidth="84"
                        Click="BtnConfirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
