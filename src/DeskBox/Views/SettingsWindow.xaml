<Window x:Class="DeskBox.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBox - 设置中心"
        Width="810"
        Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="NordNavRadioStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource NordFontSans}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource NordTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="IconPath"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{DynamicResource NordTextTertiaryBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="15" Height="15"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NordHoverOverlayBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NordTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NordSelectionPillBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NordTextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource NordAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnapshotItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource NordSurface3Brush}"
                                BorderBrush="{DynamicResource NordBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NordBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NordSelectionPillBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NordAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource NordSurface0Brush}"
            BorderBrush="{DynamicResource NordBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 (Surface1) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource NordSurface1Brush}"
                    BorderBrush="{DynamicResource NordBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/deskbox.ico"
                               Width="20" Height="20"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="DeskBox"
                                   FontFamily="{StaticResource NordFontSans}"
                                   Foreground="{DynamicResource NordTextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource NordSurface3Brush}"
                                BorderBrush="{DynamicResource NordBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="设置中心"
                                       FontFamily="{StaticResource NordFontSans}"
                                       Foreground="{DynamicResource NordTextSecondaryBrush}"
                                       FontSize="11.5"
                                       FontWeight="Medium"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnQuickTheme"
                                AutomationProperties.AutomationId="BtnQuickTheme"
                                AutomationProperties.Name="切换界面主题"
                                Style="{StaticResource NordChipButtonStyle}"
                                Margin="0,0,8,0"
                                Click="BtnQuickTheme_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ThemeChipIcon"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      Data="M 7,1.5 A 5.5,5.5 0 1 0 12.5,7 A 4.2,4.2 0 0 1 7,1.5 Z"
                                      Stroke="{DynamicResource NordAccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"/>
                                <TextBlock x:Name="TxtQuickThemeLabel" Text="跟随系统" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseButton"
                                AutomationProperties.AutomationId="SettingsCloseButton"
                                AutomationProperties.Name="关闭设置中心"
                                Style="{StaticResource NordWindowCloseButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体：左导航 (Surface1) + 右画布 (Surface0) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="192"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource NordSurface1Brush}"
                        BorderBrush="{DynamicResource NordBorderSubtleBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,12"
                        Padding="10,14,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="功能分类"
                                       Style="{StaticResource NordEyebrowStyle}"
                                       Margin="10,0,0,8"/>
                            <RadioButton x:Name="NavGeneral"
                                         AutomationProperties.Name="基础设置"
                                         Style="{StaticResource NordNavRadioStyle}"
                                         Tag="M 2,4 H 12 M 2,8 H 12 M 2,12 H 12 M 5,2.5 V 5.5 M 9,6.5 V 9.5 M 6,10.5 V 13.5"
                                         Content="基础设置"
                                         IsChecked="True"
                                         Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavTidy"
                                         AutomationProperties.Name="桌面整理"
                                         Style="{StaticResource NordNavRadioStyle}"
                                         Tag="M 2,2 H 6.5 V 6.5 H 2 Z M 8.5,2 H 13 V 6.5 H 8.5 Z M 2,8.5 H 6.5 V 13 H 2 Z M 8.5,8.5 H 13 V 13 H 8.5 Z"
                                         Content="桌面整理"
                                         Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavMonitors"
                                         AutomationProperties.Name="多屏布局"
                                         Style="{StaticResource NordNavRadioStyle}"
                                         Tag="M 1.5,2.5 H 13.5 V 10.5 H 1.5 Z M 5,13 H 10 M 7.5,10.5 V 13"
                                         Content="多屏布局"
                                         Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAbout"
                                         AutomationProperties.Name="关于与性能"
                                         Style="{StaticResource NordNavRadioStyle}"
                                         Tag="M 1.5,8 H 4 L 5.8,3.5 L 8.5,12 L 10.5,6.5 L 12,8 H 13.5"
                                         Content="关于与性能"
                                         Checked="Nav_Checked"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{DynamicResource NordSurface2Brush}"
                                BorderBrush="{DynamicResource NordBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource NordSuccessBrush}" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="TxtSidebarMemory"
                                               Text="-- MB"
                                               FontFamily="{StaticResource NordFontSans}"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource NordTextPrimaryBrush}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="单进程 · 零后台推广"
                                           FontFamily="{StaticResource NordFontSans}"
                                           Foreground="{DynamicResource NordTextTertiaryBrush}"
                                           FontSize="11.5"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧主内容区 (Surface0) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 页面抬头 -->
                    <StackPanel Grid.Row="0" Margin="28,20,28,12">
                        <TextBlock x:Name="TxtPageTitle"
                                   Text="基础设置"
                                   Style="{StaticResource NordPageTitleStyle}"/>
                        <TextBlock x:Name="TxtPageSubtitle"
                                   Text="管理界面主题、系统启动项、托盘常驻与全局快捷键"
                                   Style="{StaticResource NordSettingCaptionStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer x:Name="MainScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="28,0,22,24">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource NordScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <Grid x:Name="ContentAnimatedHost" Margin="0,0,6,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ContentSlideTransform" Y="0"/>
                            </Grid.RenderTransform>

                            <!-- 1. 基础设置 -->
                            <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                                <TextBlock Text="界面与动效" Style="{StaticResource NordEyebrowStyle}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource NordCardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="界面主题" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="切换 Nord Snow Storm 浅色或 Polar Night 深色" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="ComboUiTheme"
                                                      Grid.Column="1"
                                                      AutomationProperties.AutomationId="ComboUiTheme"
                                                      AutomationProperties.Name="界面主题"
                                                      Width="172"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="ComboUiTheme_SelectionChanged">
                                                <ComboBoxItem Content="跟随系统" Tag="System"/>
                                                <ComboBoxItem Content="浅色 Snow Storm" Tag="Light"/>
                                                <ComboBoxItem Content="深色 Polar Night" Tag="Dark"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Style="{StaticResource NordRowDividerStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="减弱界面动效" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="切换导航页时直接显现，跳过位移动画" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkReduceMotion"
                                                      Grid.Column="1"
                                                      AutomationProperties.AutomationId="ChkReduceMotion"
                                                      AutomationProperties.Name="减弱界面动效"
                                                      Style="{StaticResource NordToggleSwitchStyle}"
                                                      Click="SettingCheckbox_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="运行与托盘" Style="{StaticResource NordEyebrowStyle}" Margin="0,18,0,8"/>
                                <Border Style="{StaticResource NordCardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="开机启动 DeskBox" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="登录 Windows 后自动恢复已整理的桌面格子" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoStart"
                                                      Grid.Column="1"
                                                      AutomationProperties.Name="开机启动 DeskBox"
                                                      Style="{StaticResource NordToggleSwitchStyle}"
                                                      Click="SettingCheckbox_Changed"/>
                                        </Grid>

                                        <Border Style="{StaticResource NordRowDividerStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="开启 D3D 硬件加速" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="关闭可节省约 40 MB 后台内存，推荐保持关闭" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkHwAccel"
                                                      Grid.Column="1"
                                                      AutomationProperties.Name="开启硬件加速渲染"
                                                      Style="{StaticResource NordToggleSwitchStyle}"
                                                      Click="SettingCheckbox_Changed"/>
                                        </Grid>

                                        <Border Style="{StaticResource NordRowDividerStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="常驻系统托盘" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="隐藏所有格子窗口时不退出后台服务" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkMinToTray"
                                                      Grid.Column="1"
                                                      AutomationProperties.Name="常驻系统托盘"
                                                      Style="{StaticResource NordToggleSwitchStyle}"
                                                      Click="SettingCheckbox_Changed"/>
                                        </Grid>

                                        <Border Style="{StaticResource NordRowDividerStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="隐藏系统托盘图标" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="隐藏后仍可通过格子右上角菜单或桌面右键进入设置" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkHideTrayIcon"
                                                      Grid.Column="1"
                                                      AutomationProperties.AutomationId="ChkHideTrayIcon"
                                                      AutomationProperties.Name="隐藏系统托盘图标"
                                                      Style="{StaticResource NordToggleSwitchStyle}"
                                                      Click="SettingCheckbox_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="全局快捷键" Style="{StaticResource NordEyebrowStyle}" Margin="0,18,0,8"/>
                                <Border Style="{StaticResource NordCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="一键隐藏 / 显示全部图标" Style="{StaticResource NordSettingTitleStyle}"/>
                                            <TextBlock Text="快速切换纯净桌面视图" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ComboHotkey"
                                                  Grid.Column="1"
                                                  AutomationProperties.Name="全局快捷键"
                                                  Width="172"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="ComboHotkey_SelectionChanged">
                                            <ComboBoxItem Content="Alt+Space"/>
                                            <ComboBoxItem Content="Alt+D"/>
                                            <ComboBoxItem Content="Ctrl+Shift+D"/>
                                            <ComboBoxItem Content="无"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 2. 桌面整理 -->
                            <StackPanel x:Name="PanelTidy" Visibility="Collapsed">
                                <TextBlock Text="行为与显示" Style="{StaticResource NordEyebrowStyle}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource NordCardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="双击桌面空白处隐藏所有图标" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="快速展示纯净桌面壁纸，再次双击即可恢复" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkDoubleClickHide"
                                                      Grid.Column="1"
                                                      AutomationProperties.Name="双击桌面空白隐藏所有图标"
                                                      Style="{StaticResource NordToggleSwitchStyle}"
                                                      Click="SettingCheckbox_Changed"/>
                                        </Grid>

                                        <Border Style="{StaticResource NordRowDividerStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="格子毛玻璃效果" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="为桌面格子启用低占用壁纸模糊质感" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkFrostedGlass"
                                                      Grid.Column="1"
                                                      AutomationProperties.Name="格子毛玻璃效果"
                                                      Style="{StaticResource NordToggleSwitchStyle}"
                                                      Click="SettingCheckbox_Changed"/>
                                        </Grid>

                                        <Border Style="{StaticResource NordRowDividerStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="收起格子后悬停标题自动展开" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="鼠标移动到折叠状态标题栏时自动展开内容" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAutoExpand"
                                                      Grid.Column="1"
                                                      AutomationProperties.Name="收起格子后悬停标题自动展开"
                                                      Style="{StaticResource NordToggleSwitchStyle}"
                                                      Click="SettingCheckbox_Changed"/>
                                        </Grid>

                                        <Border Style="{StaticResource NordRowDividerStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="隐藏 Windows 原生桌面图标" Style="{StaticResource NordSettingTitleStyle}"/>
                                                <TextBlock Text="避免与桌面格子重复展示，退出时自动无损恢复" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkHideNativeIcons"
                                                      Grid.Column="1"
                                                      AutomationProperties.Name="隐藏 Windows 原生桌面图标"
                                                      Style="{StaticResource NordToggleSwitchStyle}"
                                                      Click="SettingCheckbox_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource NordInsetStyle}" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              Margin="0,2,10,0"
                                              VerticalAlignment="Top"
                                              Data="M 7,1 A 6,6 0 1 1 6.99,1 Z M 7,6 V 10.5 M 7,3.8 V 4"
                                              Stroke="{DynamicResource NordAccentBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="所有文件与文件夹始终保留在原桌面目录，资源管理器与第三方应用工作路径完全不受影响。"
                                                   Style="{StaticResource NordSettingCaptionStyle}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="快捷操作" Style="{StaticResource NordEyebrowStyle}" Margin="0,16,0,8"/>
                                <Border Style="{StaticResource NordCardStyle}">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button AutomationProperties.Name="新建一个桌面格子"
                                                Style="{StaticResource NordPrimaryButtonStyle}"
                                                Content="+ 新建桌面格子"
                                                Margin="0,0,8,8"
                                                Click="BtnNewBox_Click"/>
                                        <Button AutomationProperties.Name="新建桌面未整理动态格子"
                                                Style="{StaticResource NordSecondaryButtonStyle}"
                                                Content="+ 桌面未整理动态格子"
                                                Margin="0,0,8,8"
                                                Click="BtnUnorganizedBox_Click"/>
                                        <Button AutomationProperties.Name="全部展开或全部折叠"
                                                Style="{StaticResource NordSecondaryButtonStyle}"
                                                Content="全部展开 / 折叠"
                                                Margin="0,0,8,8"
                                                Click="BtnToggleCollapseAll_Click"/>
                                        <Button AutomationProperties.Name="定制格子外观"
                                                Style="{StaticResource NordSecondaryButtonStyle}"
                                                Content="定制格子外观..."
                                                Margin="0,0,8,8"
                                                Click="BtnCustomizeAppearance_Click"/>
                                        <Button x:Name="BtnRestoreToDesktop"
                                                AutomationProperties.AutomationId="BtnRestoreToDesktop"
                                                AutomationProperties.Name="恢复桌面显示"
                                                Style="{StaticResource NordDangerButtonStyle}"
                                                Content="清空格子并恢复桌面显示"
                                                Margin="0,0,0,8"
                                                Click="BtnRestoreToDesktop_Click"/>
                                    </WrapPanel>
                                </Border>
                            </StackPanel>

                            <!-- 3. 多屏布局 -->
                            <StackPanel x:Name="PanelMonitors" Visibility="Collapsed">
                                <TextBlock Text="当前检测到的显示器拓扑" Style="{StaticResource NordEyebrowStyle}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource NordCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource NordInsetStyle}" Margin="0,0,0,12">
                                            <TextBlock x:Name="TxtCurrentTopology"
                                                       FontFamily="{StaticResource NordFontSans}"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{DynamicResource NordTextPrimaryBrush}"
                                                       FontSize="12.5"
                                                       LineHeight="19"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button AutomationProperties.Name="保存当前多屏布局快照"
                                                    Style="{StaticResource NordPrimaryButtonStyle}"
                                                    Content="保存当前布局快照"
                                                    Margin="0,0,8,0"
                                                    Click="BtnSaveSnapshot_Click"/>
                                            <Button AutomationProperties.Name="立即按当前拓扑还原位置"
                                                    Style="{StaticResource NordSecondaryButtonStyle}"
                                                    Content="立即重新校准位置"
                                                    Click="BtnReapplySnapshot_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="已记忆的拓扑快照（热插拔时自动匹配并无损切换）" Style="{StaticResource NordEyebrowStyle}" Margin="0,18,0,8"/>
                                <Border Style="{StaticResource NordCardStyle}" Padding="8">
                                    <Grid>
                                        <ListBox x:Name="SnapshotsListBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Height="204"
                                                 ItemContainerStyle="{StaticResource SnapshotItemContainerStyle}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource NordScrollBarStyle}"/>
                                            </ListBox.Resources>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Background="{DynamicResource NordAccentTintBrush}"
                                                                CornerRadius="4"
                                                                Padding="7,2"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BoxCountLabel}"
                                                                       FontFamily="{StaticResource NordFontSans}"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       Foreground="{DynamicResource NordAccentBrush}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Description}"
                                                                   FontFamily="{StaticResource NordFontSans}"
                                                                   Foreground="{DynamicResource NordTextPrimaryBrush}"
                                                                   FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding UpdatedLabel}"
                                                                   FontFamily="{StaticResource NordFontSans}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   Foreground="{DynamicResource NordTextTertiaryBrush}"
                                                                   FontSize="11.5"
                                                                   Margin="12,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="TxtNoSnapshots"
                                                   Text="暂无保存的拓扑快照，点击上方“保存当前布局快照”即可记录"
                                                   Style="{StaticResource NordSettingCaptionStyle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 4. 关于与性能 -->
                            <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                                <TextBlock Text="运行状态概览" Style="{StaticResource NordEyebrowStyle}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource NordCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="当前工作集内存" Style="{StaticResource NordEyebrowStyle}"/>
                                            <TextBlock x:Name="TxtMemoryUsage"
                                                       Text="-- MB"
                                                       Style="{StaticResource NordStatValueStyle}"
                                                       Foreground="{DynamicResource NordSuccessBrush}"
                                                       Margin="0,6,0,4"/>
                                            <TextBlock Text="单进程驻留 · 零云搜索 · 零推广"
                                                       Style="{StaticResource NordSettingCaptionStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource NordCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="已收纳桌面格子" Style="{StaticResource NordEyebrowStyle}"/>
                                            <TextBlock x:Name="TxtBoxStats"
                                                       Text="0 个格子"
                                                       Style="{StaticResource NordStatValueStyle}"
                                                       Margin="0,6,0,4"/>
                                            <TextBlock x:Name="TxtSnapshotStats"
                                                       Text="已记忆 0 组多屏拓扑快照"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Style="{StaticResource NordSettingCaptionStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="本地配置与内存维护" Style="{StaticResource NordEyebrowStyle}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource NordCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="配置存储目录（仅保存在本机，永不上传）"
                                                   Style="{StaticResource NordSettingTitleStyle}"
                                                   Margin="0,0,0,8"/>
                                        <Border Style="{StaticResource NordInsetStyle}" Margin="0,0,0,14">
                                            <TextBlock x:Name="TxtConfigPath"
                                                       FontFamily="{StaticResource NordFontSans}"
                                                       Foreground="{DynamicResource NordTextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Button AutomationProperties.Name="释放图标缓存与整理内存"
                                                    Style="{StaticResource NordPrimaryButtonStyle}"
                                                    Content="清理缓存并优化内存"
                                                    Margin="0,0,8,0"
                                                    Click="BtnTrimMemory_Click"/>
                                            <Button AutomationProperties.Name="打开配置目录"
                                                    Style="{StaticResource NordSecondaryButtonStyle}"
                                                    Content="打开配置文件夹"
                                                    Click="BtnOpenConfigFolder_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
