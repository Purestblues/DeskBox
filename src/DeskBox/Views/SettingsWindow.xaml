<Window x:Class="DeskBox.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBox - 设置中心"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#1E2025"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Foreground" Value="#A8B0BC"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#343842"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EBF2"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    CornerRadius="3"
                                    Background="#2E323B"
                                    BorderBrush="#4A505D"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <TextBlock x:Name="Check"
                                           Text="✓"
                                           Foreground="#18D17B"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#18D17B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3A3F4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#343842"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="BorderBrush" Value="#484E5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#434856"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#292D36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E2025" CornerRadius="8" BorderBrush="#333742" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="#191B1F" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Image Source="pack://application:,,,/Assets/deskbox.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="DeskBox - 设置中心" Foreground="#F0F2F5" FontSize="14" FontWeight="Medium"/>
                </StackPanel>
                <Button x:Name="CloseButton"
                        AutomationProperties.AutomationId="SettingsCloseButton"
                        AutomationProperties.Name="关闭设置中心"
                        HorizontalAlignment="Right"
                        Width="44" Height="46"
                        Background="Transparent"
                        Foreground="#B0B8C4"
                        BorderThickness="0"
                        FontSize="15"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        Content="✕"/>
            </Grid>

            <!-- 主体：左导航 + 右内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏 -->
                <Border Grid.Column="0" Background="#1B1D22" BorderBrush="#2A2E38" BorderThickness="0,1,1,0">
                    <StackPanel Margin="0,14,0,0">
                        <RadioButton x:Name="NavGeneral"
                                     AutomationProperties.Name="基础设置"
                                     Style="{StaticResource NavRadioStyle}"
                                     Content="基础设置"
                                     IsChecked="True"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTidy"
                                     AutomationProperties.Name="桌面整理"
                                     Style="{StaticResource NavRadioStyle}"
                                     Content="桌面整理"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMonitors"
                                     AutomationProperties.Name="多屏布局"
                                     Style="{StaticResource NavRadioStyle}"
                                     Content="多屏布局"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAbout"
                                     AutomationProperties.Name="关于与性能"
                                     Style="{StaticResource NavRadioStyle}"
                                     Content="关于与性能"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                </Border>

                <!-- 右侧内容区 -->
                <Border Grid.Column="1" BorderBrush="#2A2E38" BorderThickness="0,1,0,0" Padding="32,24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- 1. 基础设置 -->
                            <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                                <TextBlock Text="基础设置" Foreground="#98A0AD" FontSize="12.5" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkAutoStart"
                                          AutomationProperties.Name="开机启动 DeskBox"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="开机启动 DeskBox"
                                          Click="SettingCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHwAccel"
                                          AutomationProperties.Name="开启硬件加速渲染"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="开启 D3D 硬件加速（关闭可节省约 40MB 后台内存，推荐保持关闭）"
                                          Click="SettingCheckbox_Changed"/>
                                <CheckBox x:Name="ChkMinToTray"
                                          AutomationProperties.Name="常驻系统托盘"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="常驻系统托盘（隐藏所有窗口时不退出）"
                                          Click="SettingCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHideTrayIcon"
                                          AutomationProperties.AutomationId="ChkHideTrayIcon"
                                          AutomationProperties.Name="隐藏系统托盘图标"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="隐藏系统托盘图标（可通过格子右上角菜单或桌面右键进入设置）"
                                          Click="SettingCheckbox_Changed"/>

                                <TextBlock Text="全局快捷键" Foreground="#98A0AD" FontSize="12.5" Margin="0,24,0,10"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="一键隐藏 / 显示全部图标：" Foreground="#E0E6EE" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="ComboHotkey"
                                              AutomationProperties.Name="全局快捷键"
                                              Width="150"
                                              SelectionChanged="ComboHotkey_SelectionChanged">
                                        <ComboBoxItem Content="Alt+Space"/>
                                        <ComboBoxItem Content="Alt+D"/>
                                        <ComboBoxItem Content="Ctrl+Shift+D"/>
                                        <ComboBoxItem Content="无"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- 2. 桌面整理 -->
                            <StackPanel x:Name="PanelTidy" Visibility="Collapsed">
                                <TextBlock Text="功能设置" Foreground="#98A0AD" FontSize="12.5" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkDoubleClickHide"
                                          AutomationProperties.Name="双击桌面空白隐藏所有图标"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="双击桌面空白处隐藏所有图标（展示纯净桌面）"
                                          Click="SettingCheckbox_Changed"/>
                                <CheckBox x:Name="ChkFrostedGlass"
                                          AutomationProperties.Name="格子毛玻璃效果"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="格子毛玻璃效果（流畅低占用 BlurBehind）"
                                          Click="SettingCheckbox_Changed"/>
                                <CheckBox x:Name="ChkAutoExpand"
                                          AutomationProperties.Name="收起格子后悬停标题自动展开"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="收起格子后，鼠标移动到标题时自动展开"
                                          Click="SettingCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHideNativeIcons"
                                          AutomationProperties.Name="隐藏 Windows 原生桌面图标"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Content="隐藏 Windows 原生桌面图标（退出时自动恢复）"
                                          Click="SettingCheckbox_Changed"/>

                                <TextBlock Text="说明：所有文件与文件夹始终保留在原桌面目录，资源管理器与第三方应用工作路径完全不受影响。"
                                           Foreground="#7E8899" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,14"/>

                                <TextBlock Text="快捷操作" Foreground="#98A0AD" FontSize="12.5" Margin="0,8,0,10"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button AutomationProperties.Name="新建一个桌面格子"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Content="+ 新建桌面格子"
                                            Margin="0,0,10,10"
                                            Click="BtnNewBox_Click"/>
                                    <Button AutomationProperties.Name="新建桌面未整理动态格子"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Content="+ 桌面未整理动态格子"
                                            Margin="0,0,10,10"
                                            Click="BtnUnorganizedBox_Click"/>
                                    <Button AutomationProperties.Name="全部展开或全部折叠"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Content="全部展开 / 折叠"
                                            Margin="0,0,10,10"
                                            Click="BtnToggleCollapseAll_Click"/>
                                    <Button AutomationProperties.Name="恢复桌面显示"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Content="清空格子并恢复桌面显示"
                                            Margin="0,0,10,10"
                                            Click="BtnRestoreToDesktop_Click"/>
                                    <Button AutomationProperties.Name="定制格子外观"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Content="定制格子外观..."
                                            Margin="0,0,0,10"
                                            Click="BtnCustomizeAppearance_Click"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 3. 多屏布局 -->
                            <StackPanel x:Name="PanelMonitors" Visibility="Collapsed">
                                <TextBlock Text="当前检测到的显示器拓扑" Foreground="#98A0AD" FontSize="12.5" Margin="0,0,0,8"/>
                                <Border Background="#262930" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                                    <TextBlock x:Name="TxtCurrentTopology"
                                               Foreground="#E6ECF5"
                                               FontSize="12.5"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button AutomationProperties.Name="保存当前多屏布局快照"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Content="保存当前布局快照"
                                            Margin="0,0,10,0"
                                            Click="BtnSaveSnapshot_Click"/>
                                    <Button AutomationProperties.Name="立即按当前拓扑还原位置"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Content="立即重新校准位置"
                                            Click="BtnReapplySnapshot_Click"/>
                                </StackPanel>

                                <TextBlock Text="已记忆的拓扑快照（热插拔时自动匹配并无损切换）" Foreground="#98A0AD" FontSize="12.5" Margin="0,6,0,8"/>
                                <ListBox x:Name="SnapshotsListBox"
                                         Background="#262930"
                                         Foreground="#DCE2EC"
                                         BorderThickness="0"
                                         Height="180"
                                         Padding="6"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,4"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- 4. 关于与性能 -->
                            <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                                <TextBlock Text="DeskBox 轻量桌面格子" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="单进程 · 零云搜索 · 零弹窗推销 · 多显示器拓扑自适应" Foreground="#9AA3B2" FontSize="13" Margin="0,0,0,20"/>

                                <Border Background="#262930" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtMemoryUsage" Foreground="#18D17B" FontSize="13.5" FontWeight="Medium"/>
                                        <TextBlock x:Name="TxtConfigPath" Foreground="#9AA3B2" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button AutomationProperties.Name="释放图标缓存与整理内存"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Content="清理缓存并优化内存"
                                            Margin="0,0,10,0"
                                            Click="BtnTrimMemory_Click"/>
                                    <Button AutomationProperties.Name="打开配置目录"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Content="打开配置文件夹"
                                            Click="BtnOpenConfigFolder_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
