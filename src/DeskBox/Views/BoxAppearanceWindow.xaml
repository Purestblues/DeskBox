<Window x:Class="DeskBox.Views.BoxAppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBox - 格子外观设置"
        Width="464"
        Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="NordAppearanceComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="168"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="NordTabularBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NordFontSans}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource NordTextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource NordSurface0Brush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource NordBorderStrongBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 (Surface1) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource NordSurface1Brush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{DynamicResource NordBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,42,0">
                        <Image Source="pack://application:,,,/Assets/deskbox.ico"
                               Width="18" Height="18"
                               Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtWindowTitle"
                                   Text="格子外观设置"
                                   FontFamily="{StaticResource NordFontSans}"
                                   Foreground="{DynamicResource NordTextPrimaryBrush}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource NordSelectionPillBrush}"
                                CornerRadius="6"
                                Padding="8,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTargetBoxBadge"
                                       Text="格子"
                                       FontFamily="{StaticResource NordFontSans}"
                                       Foreground="{DynamicResource NordAccentBrush}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       MaxWidth="150"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <Button x:Name="BtnClose"
                            AutomationProperties.AutomationId="AppearanceCloseButton"
                            AutomationProperties.Name="关闭外观设置"
                            HorizontalAlignment="Right"
                            Style="{StaticResource NordWindowCloseButtonStyle}"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 主配置区域 (Surface0) -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,14,12,16">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource NordScrollBarStyle}"/>
                </ScrollViewer.Resources>

                <StackPanel Margin="0,0,6,0">
                    <!-- 1. 主题配色 -->
                    <TextBlock Text="主题配色与自定义颜色" Style="{StaticResource NordEyebrowStyle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource NordCardStyle}" Padding="14">
                        <StackPanel>
                            <WrapPanel x:Name="PresetColorsPanel" Margin="0,0,0,8"/>

                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CurrentColorPreview"
                                        Grid.Column="0"
                                        Width="34" Height="34"
                                        CornerRadius="6"
                                        BorderBrush="{DynamicResource NordBorderStrongBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtCustomHex"
                                         Grid.Column="1"
                                         AutomationProperties.AutomationId="TxtCustomHex"
                                         AutomationProperties.Name="自定义HEX颜色"
                                         Style="{StaticResource NordTextBoxStyle}"
                                         Typography.NumeralAlignment="Tabular"
                                         KeyDown="TxtCustomHex_KeyDown"/>
                                <Button x:Name="BtnApplyHex"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="BtnApplyHex"
                                        AutomationProperties.Name="应用HEX颜色"
                                        Style="{StaticResource NordSecondaryButtonStyle}"
                                        Content="应用颜色"
                                        Margin="8,0,0,0"
                                        Click="BtnApplyHex_Click"/>
                            </Grid>

                            <!-- RGB 微调滑块 -->
                            <Border Style="{StaticResource NordInsetStyle}" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="{DynamicResource NordDangerBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderR" Grid.Row="0" Grid.Column="1" Style="{StaticResource NordSliderStyle}" AutomationProperties.Name="红色通道" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="RgbSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtRVal" Grid.Row="0" Grid.Column="2" Style="{StaticResource NordTabularBadgeTextStyle}" Foreground="{DynamicResource NordTextSecondaryBrush}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="{DynamicResource NordSuccessBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderG" Grid.Row="1" Grid.Column="1" Style="{StaticResource NordSliderStyle}" AutomationProperties.Name="绿色通道" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="RgbSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtGVal" Grid.Row="1" Grid.Column="2" Style="{StaticResource NordTabularBadgeTextStyle}" Foreground="{DynamicResource NordTextSecondaryBrush}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="{DynamicResource NordAccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderB" Grid.Row="2" Grid.Column="1" Style="{StaticResource NordSliderStyle}" AutomationProperties.Name="蓝色通道" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="RgbSlider_ValueChanged"/>
                                    <TextBlock x:Name="TxtBVal" Grid.Row="2" Grid.Column="2" Style="{StaticResource NordTabularBadgeTextStyle}" Foreground="{DynamicResource NordTextSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. 透明度与毛玻璃 -->
                    <TextBlock Text="透明度与毛玻璃质感" Style="{StaticResource NordEyebrowStyle}" Margin="0,16,0,8"/>
                    <Border Style="{StaticResource NordCardStyle}" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="背景透明度" Style="{StaticResource NordSettingTitleStyle}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider x:Name="SliderOpacity"
                                        Grid.Column="1"
                                        Style="{StaticResource NordSliderStyle}"
                                        AutomationProperties.AutomationId="SliderOpacity"
                                        AutomationProperties.Name="背景透明度"
                                        Minimum="0" Maximum="95"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="SliderOpacity_ValueChanged"/>
                                <TextBlock x:Name="TxtOpacityVal" Grid.Column="2" Style="{StaticResource NordTabularBadgeTextStyle}"/>
                            </Grid>

                            <WrapPanel Margin="0,10,0,12">
                                <Button Style="{StaticResource NordChipButtonStyle}" Content="0% 全透" Tag="0" Margin="0,0,6,0" Click="BtnQuickOpacity_Click"/>
                                <Button Style="{StaticResource NordChipButtonStyle}" Content="25%" Tag="25" Margin="0,0,6,0" Click="BtnQuickOpacity_Click"/>
                                <Button Style="{StaticResource NordChipButtonStyle}" Content="40%" Tag="40" Margin="0,0,6,0" Click="BtnQuickOpacity_Click"/>
                                <Button Style="{StaticResource NordChipButtonStyle}" Content="65%" Tag="65" Margin="0,0,6,0" Click="BtnQuickOpacity_Click"/>
                                <Button Style="{StaticResource NordChipButtonStyle}" Content="85%" Tag="85" Click="BtnQuickOpacity_Click"/>
                            </WrapPanel>

                            <Border Style="{StaticResource NordRowDividerStyle}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="毛玻璃背景模糊" Style="{StaticResource NordSettingTitleStyle}" FontSize="13" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ComboFrostedGlass"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="ComboFrostedGlass"
                                          AutomationProperties.Name="毛玻璃效果模式"
                                          Style="{StaticResource NordAppearanceComboStyle}"
                                          SelectionChanged="ComboFrostedGlass_SelectionChanged">
                                    <ComboBoxItem Content="跟随全局设置" Tag="global"/>
                                    <ComboBoxItem Content="单格开启毛玻璃" Tag="on"/>
                                    <ComboBoxItem Content="单格关闭毛玻璃" Tag="off"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. 边框与圆角 -->
                    <TextBlock Text="边框与圆角" Style="{StaticResource NordEyebrowStyle}" Margin="0,16,0,8"/>
                    <Border Style="{StaticResource NordCardStyle}" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="窗口圆角" Style="{StaticResource NordSettingTitleStyle}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider x:Name="SliderCornerRadius"
                                        Grid.Column="1"
                                        Style="{StaticResource NordSliderStyle}"
                                        AutomationProperties.AutomationId="SliderCornerRadius"
                                        AutomationProperties.Name="圆角大小"
                                        Minimum="0" Maximum="16"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="SliderCornerRadius_ValueChanged"/>
                                <TextBlock x:Name="TxtCornerVal" Grid.Column="2" Style="{StaticResource NordTabularBadgeTextStyle}"/>
                            </Grid>

                            <WrapPanel Margin="0,10,0,12">
                                <Button Style="{StaticResource NordChipButtonStyle}" Content="直角 0px" Tag="0" Margin="0,0,6,0" Click="BtnQuickCorner_Click"/>
                                <Button Style="{StaticResource NordChipButtonStyle}" Content="微圆角 6px" Tag="6" Margin="0,0,6,0" Click="BtnQuickCorner_Click"/>
                                <Button Style="{StaticResource NordChipButtonStyle}" Content="大圆角 12px" Tag="12" Click="BtnQuickCorner_Click"/>
                            </WrapPanel>

                            <Border Style="{StaticResource NordRowDividerStyle}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="边框样式" Style="{StaticResource NordSettingTitleStyle}" FontSize="13" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ComboBorderStyle"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="ComboBorderStyle"
                                          AutomationProperties.Name="边框样式"
                                          Style="{StaticResource NordAppearanceComboStyle}"
                                          SelectionChanged="ComboBorderStyle_SelectionChanged">
                                    <ComboBoxItem Content="细高光边框" Tag="Subtle"/>
                                    <ComboBoxItem Content="无边框悬浮" Tag="None"/>
                                    <ComboBoxItem Content="主题强调边框" Tag="Accent"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. 图标与文字排版 -->
                    <TextBlock Text="图标与文字" Style="{StaticResource NordEyebrowStyle}" Margin="0,16,0,8"/>
                    <Border Style="{StaticResource NordCardStyle}" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="图标尺寸" Style="{StaticResource NordSettingTitleStyle}" FontSize="13" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ComboIconSize"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="ComboIconSize"
                                          AutomationProperties.Name="图标大小"
                                          Style="{StaticResource NordAppearanceComboStyle}"
                                          SelectionChanged="ComboIconSize_SelectionChanged">
                                    <ComboBoxItem Content="小图标" Tag="Small"/>
                                    <ComboBoxItem Content="标准图标" Tag="Medium"/>
                                    <ComboBoxItem Content="大图标" Tag="Large"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="文字字号" Style="{StaticResource NordSettingTitleStyle}" FontSize="13" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ComboFontSize"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="ComboFontSize"
                                          AutomationProperties.Name="文字大小"
                                          Style="{StaticResource NordAppearanceComboStyle}"
                                          SelectionChanged="ComboFontSize_SelectionChanged">
                                    <ComboBoxItem Content="小字号" Tag="Small"/>
                                    <ComboBoxItem Content="标准字号" Tag="Medium"/>
                                    <ComboBoxItem Content="大字号" Tag="Large"/>
                                </ComboBox>
                            </Grid>

                            <Border Style="{StaticResource NordRowDividerStyle}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="开启文字阴影" Style="{StaticResource NordSettingTitleStyle}" FontSize="13"/>
                                    <TextBlock Text="全透明或复杂壁纸上防止文字撞色" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkTextShadow"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="ChkTextShadow"
                                          AutomationProperties.Name="开启文字阴影（防壁纸撞色）"
                                          Style="{StaticResource NordToggleSwitchStyle}"
                                          Click="OptionCheckBox_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 5. 标题栏样式 -->
                    <TextBlock Text="标题栏样式" Style="{StaticResource NordEyebrowStyle}" Margin="0,16,0,8"/>
                    <Border Style="{StaticResource NordCardStyle}" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="标题对齐" Style="{StaticResource NordSettingTitleStyle}" FontSize="13" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ComboTitleAlign"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="ComboTitleAlign"
                                          AutomationProperties.Name="标题对齐方式"
                                          Style="{StaticResource NordAppearanceComboStyle}"
                                          SelectionChanged="ComboTitleAlign_SelectionChanged">
                                    <ComboBoxItem Content="居中对齐" Tag="Center"/>
                                    <ComboBoxItem Content="居左对齐" Tag="Left"/>
                                </ComboBox>
                            </Grid>

                            <Border Style="{StaticResource NordRowDividerStyle}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="显示独立标题栏底色与分隔线" Style="{StaticResource NordSettingTitleStyle}" FontSize="13" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkHeaderBand"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="ChkHeaderBand"
                                          AutomationProperties.Name="显示独立标题栏底色与分隔线"
                                          Style="{StaticResource NordToggleSwitchStyle}"
                                          Click="OptionCheckBox_Changed"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="鼠标移开时自动弱化顶栏按钮" Style="{StaticResource NordSettingTitleStyle}" FontSize="13"/>
                                    <TextBlock Text="静止时仅保留格子标题，界面更纯净" Style="{StaticResource NordSettingCaptionStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkAutoFadeButtons"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="ChkAutoFadeButtons"
                                          AutomationProperties.Name="鼠标移开时自动隐藏顶栏按钮"
                                          Style="{StaticResource NordToggleSwitchStyle}"
                                          Click="OptionCheckBox_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作栏 (Surface1) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource NordSurface1Brush}"
                    CornerRadius="0,0,12,12"
                    BorderBrush="{DynamicResource NordBorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Button x:Name="BtnResetDefault"
                            AutomationProperties.AutomationId="BtnResetDefault"
                            AutomationProperties.Name="恢复默认外观"
                            Style="{StaticResource NordSecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Content="恢复默认"
                            Click="BtnResetDefault_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnApplyToAll"
                                AutomationProperties.AutomationId="BtnApplyToAll"
                                AutomationProperties.Name="同步到全部格子"
                                Style="{StaticResource NordSecondaryButtonStyle}"
                                Content="同步到全部格子"
                                Margin="0,0,8,0"
                                Click="BtnApplyToAll_Click"/>
                        <Button x:Name="BtnDone"
                                AutomationProperties.AutomationId="BtnDone"
                                AutomationProperties.Name="完成"
                                Style="{StaticResource NordPrimaryButtonStyle}"
                                Content="完成"
                                MinWidth="76"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
