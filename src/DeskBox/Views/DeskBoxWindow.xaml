<Window x:Class="DeskBox.Views.DeskBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DeskBox"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Width="300"
        Height="360">
    <Window.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#42FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 极简细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#4DFFFFFF" CornerRadius="2.5" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 底层：对齐桌面壁纸的高斯模糊层（关闭毛玻璃时设为 Transparent） -->
        <Border x:Name="BlurBackdropBorder"
                CornerRadius="5"
                Background="Transparent">
            <!-- 中层：可控透明度的主题着色罩 + 极淡玻璃边缘反光 -->
            <Border x:Name="RootBorder"
                    CornerRadius="5"
                    BorderBrush="#1CFFFFFF"
                    BorderThickness="1"
                    Background="#58202226">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题栏（与内容区浑然一体，无生硬分隔带） -->
                <Grid x:Name="HeaderGrid"
                      Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown"
                      MouseRightButtonUp="HeaderGrid_MouseRightButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="HeaderBackgroundBorder"
                            Grid.ColumnSpan="3"
                            Background="Transparent"
                            IsHitTestVisible="False"/>
                    <Border x:Name="HeaderSeparator"
                            Grid.ColumnSpan="3"
                            VerticalAlignment="Bottom"
                            Height="1"
                            Background="#1EFFFFFF"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>

                    <!-- 左侧：折叠 + 锁定（全矢量居中图标） -->
                    <StackPanel x:Name="LeftHeaderButtonsPanel" Grid.Column="0" Orientation="Horizontal" Margin="6,0,2,0" VerticalAlignment="Center">
                        <Button x:Name="CollapseButton"
                                AutomationProperties.AutomationId="CollapseButton"
                                AutomationProperties.Name="折叠或展开"
                                ToolTip="折叠 / 展开"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                Click="CollapseButton_Click">
                            <Path x:Name="CollapsePath"
                                  Width="12" Height="12"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1.5,8 L 6,3.5 L 10.5,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="LockButton"
                                AutomationProperties.AutomationId="LockButton"
                                AutomationProperties.Name="锁定位置"
                                ToolTip="锁定 / 解锁位置与大小"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                Click="LockButton_Click">
                            <Canvas Width="14" Height="14">
                                <Path x:Name="LockShacklePath"
                                      Data="M 4.5,6 V 4.3 A 2.5,2.5 0 0 1 9.5,4.3 V 5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.25"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                                <Rectangle Canvas.Left="3" Canvas.Top="6" Width="8" Height="6" RadiusX="1.2" RadiusY="1.2"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.25"/>
                            </Canvas>
                        </Button>
                    </StackPanel>

                    <!-- 中间：居中标题 / 原地重命名框 -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="格子"
                                   Foreground="#F5FFFFFF"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBox x:Name="TitleEditBox"
                                 AutomationProperties.AutomationId="TitleEditBox"
                                 AutomationProperties.Name="编辑格子标题"
                                 Visibility="Collapsed"
                                 FontSize="12.5"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Background="#CC181A1E"
                                 Foreground="White"
                                 BorderBrush="#55A0FF"
                                 BorderThickness="1"
                                 Padding="4,1"
                                 KeyDown="TitleEditBox_KeyDown"
                                 LostFocus="TitleEditBox_LostFocus"/>
                    </Grid>

                    <!-- 右侧：视图切换 + 排序 + 菜单（全矢量居中图标） -->
                    <StackPanel x:Name="RightHeaderButtonsPanel" Grid.Column="2" Orientation="Horizontal" Margin="2,0,6,0" VerticalAlignment="Center">
                        <Button x:Name="ViewModeButton"
                                AutomationProperties.AutomationId="ViewModeButton"
                                AutomationProperties.Name="切换视图"
                                ToolTip="切换列表 / 网格视图"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                Click="ViewModeButton_Click">
                            <Path x:Name="ViewModePath"
                                  Width="12" Height="12"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1,1 H 5 V 5 H 1 Z M 7,1 H 11 V 5 H 7 Z M 1,7 H 5 V 11 H 1 Z M 7,7 H 11 V 11 H 7 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="SortButton"
                                AutomationProperties.AutomationId="SortButton"
                                AutomationProperties.Name="排序"
                                ToolTip="排序方式"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                Click="SortButton_Click">
                            <Path Width="12" Height="12"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 3.5,2 V 10 M 1.5,4 L 3.5,2 L 5.5,4 M 8.5,2 V 10 M 6.5,8 L 8.5,10 L 10.5,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="MenuButton"
                                AutomationProperties.AutomationId="MenuButton"
                                AutomationProperties.Name="格子菜单"
                                ToolTip="格子菜单"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                Click="MenuButton_Click">
                            <Path Width="12" Height="12"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1.5,3 H 10.5 M 1.5,6 H 10.5 M 1.5,9 H 10.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 内容列表区 -->
                <Grid x:Name="ContentHostGrid" Grid.Row="1" Margin="4,2,4,6">
                    <ListBox x:Name="ItemsListBox"
                             AutomationProperties.AutomationId="ItemsListBox"
                             AutomationProperties.Name="格子项目列表"
                             SelectionMode="Extended"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="ItemsListBox_MouseDoubleClick"
                             PreviewKeyDown="ItemsListBox_PreviewKeyDown"
                             PreviewMouseLeftButtonDown="ItemsListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ItemsListBox_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="ItemsListBox_PreviewMouseLeftButtonUp"
                             MouseRightButtonUp="ItemsListBox_MouseRightButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0.5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent">
                                                <Border x:Name="ItemBorder"
                                                        HorizontalAlignment="Left"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="0">
                                                    <ContentPresenter/>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#24FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#48FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 框选矩形 & 拖拽排序插入线层 -->
                    <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="MarqueeRect"
                                   Fill="#387E9AFF"
                                   Stroke="#96A8C4FF"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"/>
                        <Border x:Name="InsertionIndicator"
                                Background="#38D2F2"
                                CornerRadius="1"
                                Visibility="Collapsed"/>
                        <Border x:Name="FolderDropIndicator"
                                Background="#3838D2F2"
                                BorderBrush="#D038D2F2"
                                BorderThickness="1.5"
                                CornerRadius="4"
                                Visibility="Collapsed"/>
                    </Canvas>

                    <!-- 空状态提示 -->
                    <TextBlock x:Name="EmptyHintText"
                               Text="拖入文件或快捷方式到此格子"
                               Foreground="#88FFFFFF"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>
            </Border>
        </Border>

        <!-- 四边/四角缩放热区（未锁定时可用） -->
        <Thumb x:Name="ResizeRight" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" DragStarted="Resize_DragStarted" DragDelta="ResizeRight_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeLeft" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0" DragStarted="Resize_DragStarted" DragDelta="ResizeLeft_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeBottom" Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0" DragStarted="Resize_DragStarted" DragDelta="ResizeBottom_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <Thumb x:Name="ResizeBottomRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0" DragStarted="Resize_DragStarted" DragDelta="ResizeBottomRight_DragDelta" DragCompleted="Resize_DragCompleted"/>
    </Grid>
</Window>
