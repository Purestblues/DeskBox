<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DeskBox</AssemblyName>
    <RootNamespace>DeskBox</RootNamespace>
    <Version>1.2.1</Version>
    <Product>DeskBox</Product>
    <Description>轻量、零推广、多显示器友好的 Windows 桌面格子工具</Description>
    <ApplicationIcon>Assets\deskbox.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\deskbox.ico" />
  </ItemGroup>

</Project>
